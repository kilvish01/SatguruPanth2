{
  "name": "book-reader-backend",
  "version": "1.0.0",
  "description": "Backend for book reading application with PDF upload to AWS",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "offline": "serverless offline",
    "deploy": "serverless deploy",
    "deploy:phase2dev": "serverless deploy --stage phase2dev",
    "seed:phase2dev": "node scripts/seedDev.js --apply",
    "extract:book": "node scripts/extraction/extractBook.js",
    "extract:all": "node scripts/extraction/extractAllBooks.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "aws-sdk": "^2.1490.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^9.14.1",
    "jsonwebtoken": "^9.0.2",
    "pdf-to-img": "^4.5.0",
    "serverless-http": "^3.2.0",
    "sharp": "^0.33.5",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "serverless-offline": "^14.4.0"
  },
  "keywords": [
    "aws",
    "lambda",
    "s3",
    "dynamodb",
    "pdf",
    "books"
  ],
